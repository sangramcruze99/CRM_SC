# ==============================================================================
# Business OS & Enterprise CRM — Staging Environment Configuration Template
# ==============================================================================

NODE_ENV=staging
PORT=4000
CORS_ORIGIN=https://staging-crm.yourdomain.com

# 1. Database (Staging PostgreSQL)
DATABASE_URL=postgresql://staging_user:staging_pass@staging-pg:5432/business_os_staging?schema=public&connection_limit=15&pool_timeout=20

# 2. Redis & Distributed Queues (Staging)
ENABLE_BULLMQ=true
REDIS_URL=redis://:staging_redis_pass@staging-redis:6379/1
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_pass

# 3. Authentication & Security (Staging Isolated)
JWT_SECRET=staging_isolated_jwt_secret_min32chars_random_key_abc123
JWT_EXPIRES_IN=1d
MFA_ENCRYPTION_KEY=staging_mfa_encryption_key_256bit_hex_64chars_key_placeholder
API_KEY=staging_api_key_isolated_hex_min32chars
SYSTEM_API_KEY=staging_api_key_isolated_hex_min32chars

# 4. Private Object Storage (Staging S3 / MinIO)
AWS_ACCESS_KEY_ID=staging_s3_key
AWS_SECRET_ACCESS_KEY=staging_s3_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=crm-business-os-staging-vault

# 5. External Payment & Webhooks (Stripe Sandbox)
STRIPE_SECRET_KEY=sk_test_<SANDBOX_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<SANDBOX_SECRET>
STRIPE_PUBLIC_KEY=pk_test_<SANDBOX_KEY>

# 6. Communications (Sandbox / Test Mailer)
RESEND_API_KEY=re_sandbox_key
RESEND_FROM_EMAIL=Staging CRM <staging@resend.dev>
