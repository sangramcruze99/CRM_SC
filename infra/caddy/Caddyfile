# Business OS — Production Ingress Caddyfile
# Automatic HTTPS, TLS 1.3, Strict Security Headers & Reverse Proxy

{
    admin off
    servers {
        protocols h1 h2 h3
    }
}

localhost, *.businessos.local {
    tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key {
        protocols tls1.2 tls1.3
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob: ws: wss:; frame-ancestors 'self';"
        X-Ingress-Proxy "BusinessOS-Production-Ingress/1.0"
        -Server
    }

    # Health check
    handle /healthz {
        respond `{"status":"UP","ingress":"caddy-tls1.3"}` 200 {
            header Content-Type application/json
        }
    }

    # Route: API Gateway
    handle /api/* {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-Proto https
        }
    }

    # Route: MinIO S3 Vault
    handle /vault/* {
        uri strip_prefix /vault
        reverse_proxy 127.0.0.1:9000 {
            header_up Host {upstream_hostport}
        }
    }

    # Route: WebSockets
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:3014
    }

    # Default Route: Next.js Web-Core
    handle {
        reverse_proxy 127.0.0.1:4000
    }
}
