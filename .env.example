# ==============================================================================
# Business OS & Enterprise CRM — Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://crm.yourdomain.com

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_strong_password@localhost:5432/crm_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. Redis & BullMQ (Queue & Workflow Automation)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
JWT_EXPIRES_IN="7d"
# Direct programmatic system API key (Passed via X-API-Key or Bearer)
API_KEY="your-system-32-hex-api-key"
SYSTEM_API_KEY="your-system-32-hex-api-key"

# ------------------------------------------------------------------------------
# 4. AI Engine & Copilot
# ------------------------------------------------------------------------------
# OpenAI API Key (Required for askAI, copilot, and smart analysis)
OPENAI_API_KEY=""
# Google Gemini API Key (High-speed Multimodal Reasoning Engine)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-gemini-api-key"
# Groq API Key (Ultra-fast real-time inference)
GROQ_API_KEY="gsk_your_groq_api_key"
# OpenRouter API Key (GPT-4o, Claude 3.5 Sonnet, DeepSeek)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"

# ------------------------------------------------------------------------------
# 5. Email & Communication Services (Resend & SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Business OS <onboarding@resend.dev>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key_here"
SMTP_FROM="Business OS <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 6. SMS & Telephony (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="AC_or_SK_your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_or_secret"
TWILIO_API_KEY_SID="SK_your_twilio_api_key_sid"
TWILIO_API_KEY_SECRET="your_twilio_api_key_secret"
TWILIO_PHONE_NUMBER="+15005550006"

# ------------------------------------------------------------------------------
# 7. Payments & Commerce (Stripe)
# ------------------------------------------------------------------------------
STRIPE_ACCOUNT_ID="acct_your_stripe_account_id"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"

# ------------------------------------------------------------------------------
# 8. File Storage (AWS S3 or Compatible)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="crm-business-os-assets"

# ------------------------------------------------------------------------------
# 9. Python AI & ML Infrastructure Service (:3030)
# ------------------------------------------------------------------------------
PYTHON_AI_URL="http://localhost:3030"
PYTHON_AI_PORT=3030
PYTHON_AI_HOST="0.0.0.0"
PYTHON_AI_API_KEY="business-os-internal-ai-key-secret"
PYTHON_AI_REQUIRE_AUTH="true"
DEFAULT_MODEL="groq/compound"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
ENABLE_LOCAL_MODELS="false"
ENABLE_TRAINING="true"
ENABLE_EVALUATION="true"
