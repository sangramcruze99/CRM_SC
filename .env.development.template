# ==============================================================================
# Business OS & Enterprise CRM — Local Development Configuration Template
# ==============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# 1. Database (Local PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/business_os?schema=public

# 2. Redis & Distributed Queues (Local Dev)
ENABLE_BULLMQ=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Authentication & Security (Local Ephemeral)
JWT_SECRET=dev-ephemeral-jwt-secret-do-not-use-in-production-min32chars
JWT_EXPIRES_IN=30d
MFA_ENCRYPTION_KEY=dev-ephemeral-mfa-encryption-key-256bit-hex-64characters-placeholder
API_KEY=dev-local-api-key-32characters-hex-value
SYSTEM_API_KEY=dev-local-api-key-32characters-hex-value

# 4. Storage (Local Vault / MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=crm-business-os-dev-vault
S3_ENDPOINT=http://127.0.0.1:9000
