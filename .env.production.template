# ==============================================================================
# Business OS & Enterprise CRM — Production Environment Configuration Template
# ==============================================================================
# Mandatory: In production, all secrets must be populated via enterprise secret managers
# (e.g., AWS Secrets Manager, HashiCorp Vault, or Doppler).
# The system enforces FAIL-CLOSED startup: missing or default secrets prevent booting.

NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://crm.yourdomain.com

# 1. Database (Production PostgreSQL 16+)
# Minimum connection pool size: 20, Pool timeout: 20s
DATABASE_URL=postgresql://<PG_USER>:<PG_PASSWORD>@<PG_HOST>:5432/<PG_DATABASE>?schema=public&connection_limit=25&pool_timeout=20

# 2. Redis & Distributed Queues (BullMQ)
ENABLE_BULLMQ=true
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379/0
REDIS_HOST=<REDIS_HOST>
REDIS_PORT=6379
REDIS_PASSWORD=<SECURE_REDIS_PASSWORD>

# 3. Authentication & Security
# Generate high-entropy 256-bit key: openssl rand -base64 32
JWT_SECRET=<STRONG_RANDOM_256BIT_SECRET_MIN_32_CHARS>
JWT_EXPIRES_IN=7d
MFA_ENCRYPTION_KEY=<STRONG_RANDOM_256BIT_HEX_OR_BASE64_KEY>
API_KEY=<STRONG_RANDOM_HEX_KEY_MIN_32_CHARS>
SYSTEM_API_KEY=<STRONG_RANDOM_HEX_KEY_MIN_32_CHARS>

# 4. Private Object Storage (S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID=<PROD_S3_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<PROD_S3_SECRET_ACCESS_KEY>
AWS_REGION=us-east-1
AWS_S3_BUCKET=crm-business-os-prod-vault
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# 5. External Payment & Webhooks (Stripe Production)
STRIPE_SECRET_KEY=sk_live_<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<STRIPE_WEBHOOK_SECRET>
STRIPE_PUBLIC_KEY=pk_live_<STRIPE_PUBLIC_KEY>

# 6. Communications (Resend / SMTP)
RESEND_API_KEY=re_<PROD_API_KEY>
RESEND_FROM_EMAIL=Business OS <notifications@yourdomain.com>

# 7. Telephony (Twilio Production)
TWILIO_ACCOUNT_SID=AC<PROD_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<PROD_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<PROD_PHONE_NUMBER>

# 8. AI Engine
OPENAI_API_KEY=sk-proj-<PROD_KEY>
GEMINI_API_KEY=<PROD_KEY>
GROQ_API_KEY=gsk_<PROD_KEY>
