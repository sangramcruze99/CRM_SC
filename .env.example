# ==============================================================================
# Business OS & Enterprise CRM — Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://crm.yourdomain.com

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_strong_password@localhost:5432/crm_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. Redis & BullMQ (Queue & Workflow Automation)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. AI Engine & Copilot
# ------------------------------------------------------------------------------
# OpenAI API Key (Required for askAI, copilot, and smart analysis)
OPENAI_API_KEY=""
# Google Gemini API Key (Alternative/hybrid LLM engine)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Email & Communication Services (Resend & SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Business OS <onboarding@resend.dev>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key_here"
SMTP_FROM="Business OS <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 6. SMS & Telephony (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 7. Payments & Commerce (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# 8. File Storage (AWS S3 or Compatible)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="crm-business-os-assets"

# ------------------------------------------------------------------------------
# 9. Python AI & ML Infrastructure Service (:3030)
# ------------------------------------------------------------------------------
PYTHON_AI_URL="http://localhost:3030"
PYTHON_AI_PORT=3030
PYTHON_AI_HOST="0.0.0.0"
PYTHON_AI_API_KEY="business-os-internal-ai-key-secret"
PYTHON_AI_REQUIRE_AUTH="true"
DEFAULT_MODEL="groq/compound"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
ENABLE_LOCAL_MODELS="false"
ENABLE_TRAINING="true"
ENABLE_EVALUATION="true"
